function ejecutarDatos(chatId) {

    try {
        /* const sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet(); */
        const nombreHoja = sheet.getName();
        const data_Sheet = sheet.getDataRange().getValues(); // Leemos todo una sola vez (Eficiencia)
        // Ejemplo de lectura de la hoja activa

        sendMessage(chatId, `📊 Estás registrado en la hoja de sheet: <b>${nombreHoja}</b>`);
        // Buscamos la fila donde la columna D (índice 3) coincida con el chatId
        const filaUsuario = data_Sheet.find(fila => fila[3] == chatId);

        if (filaUsuario) {
            // filaUsuario[0] = Fecha, [1] = Nombre, [2] = Último mensaje

            sendMessage(chatId, `📊 <b>Tus Datos:</b>\n\n` +
                `👤 <b>Nombre:</b> ${filaUsuario[1]}\n` +
                `📝 <b>Último registro:</b> ${filaUsuario[2]}\n` +
                `📅 <b>Fecha:</b> ${Utilities.formatDate(filaUsuario[0], "GMT-3", "dd/MM/yyyy")}`);
        } else {
            sendMessage(chatId, "❌ No encontré registros vinculados a tu ID.");
        }
    } catch (err) {
        sendMessage(chatId, "⚠️ Error al acceder a la base de datos.");
    }
}

/**
 * Paso 2: Recibe el número y lo guarda en la hoja "saldos"
 */
function gestionarRegistroKit(chatId, producto, name, cantidadTexto) {
    const cantidad = parseFloat(cantidadTexto.replace(',', '.')); // Convertir a número válido

    if (isNaN(cantidad)) {
        sendMessage(chatId, "❌ Error: Por favor envía solo números (ej: 1500).");
        return;
    }

    // Guardar en hoja "saldos": Fecha | Nombre | Monto | ID
    CONFIG_HOJAS.PEDIDOS.appendRow([fecha, name, cantidad, producto, chatId]);

    sendMessage(chatId, `✅ <b>Registrado con éxito</b>\nSe agregó ${cantidad} <b>${producto}</b> a la hoja de cálculo.`);
}

function solicitarNumeroKit(chatId, tipoProducto) {
    const payload = {
        chat_id: chatId,
        text: `💰 <b>Modo Registro de Kits</b>\nProducto: [${tipoProducto}]\n\nEscribe la cant que deseas agregar:`,
        parse_mode: "HTML",
        reply_markup: JSON.stringify({ force_reply: true, selective: true, input_field_placeholder: "Ejemplo: 3" }) // Esto abre el teclado automáticamente
    };
    UrlFetchApp.fetch(`${TELEGRAM_URL}/sendMessage`, {
        method: "post",
        contentType: "application/json",
        payload: JSON.stringify(payload)
    });
}
// Funciones de comunicaciones
function sendMessage(chatId, text, keyboard = null) {
    const payload = { chat_id: chatId, text: text, parse_mode: "HTML" };
    if (keyboard) payload.reply_markup = JSON.stringify(keyboard);
    return fetchTelegram("sendMessage", payload);
}

function answerCallback(callbackId, text = null, showAlert = false) {

    return fetchTelegram("answerCallbackQuery",
        { callback_query_id: callbackId });
}

function fetchTelegram(metodo, payload) {
    return UrlFetchApp.fetch(`${TELEGRAM_URL}/${metodo}`, {
        method: "post",
        contentType: "application/json",
        payload: JSON.stringify(payload),
        muteHttpExceptions: true
    });
}



